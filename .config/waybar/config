{
	"layer": "top",
	"modules-left": ["custom/launcher","cpu","temperature","tray"],
	"modules-center": ["hyprland/workspaces"],
	"modules-right": ["custom/updates","custom/fanspeed","backlight","custom/pipewire","network","battery","clock","custom/nc","custom/power"],
	
	"hyprland/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"5": "",
			"default": ""
		},
		"persistent-workspaces": {
			"*": 5
		}
	},

	"custom/pipewire": {
		"tooltip": false,
		"interval": 1,
		"format": "{}",
		"on-click": "pamixer -t",
		"on-scroll-up": "pamixer -i 5",
		"on-scroll-down": "pamixer -d 5",
		"exec": "$HOME/.config/waybar/scripts/volume.sh",
	},
	"network": {
		"tooltip": false,
		"format-wifi": "  {essid}",
		"format-ethernet": ""
	},
	"backlight": {
		"tooltip": false,
		"format": " {}%",
		"interval":1,
        	"on-scroll-up": "blight set +5%",
		"on-scroll-down": "blight set -5%"
	},
    	"battery": {
        	"states": {
            		"good": 95,
            		"warning": 30,
            		"critical": 20
        	},
        	"format": "{icon}  {capacity}%",
	        "format-charging": " {capacity}%",
        	"format-plugged": " {capacity}%",
        	"format-alt": "{time} {icon}",
        	"format-icons": ["", "", "", "", ""]
    	},
	"tray":{
		"icon-size":18,
		"spacing": 10
	},
    	"cpu": {
        	"interval": 5,
        	"format": " {}%",
        	"max-length": 10
    	},
	"temperature": {
		"interval": 5,
		"format": " {}°C",
		"critical-threshold": 80
	},

    	"clock": {
		"tooltip": false,
        	"interval": 1,
        	"format": "{:%m/%d %H:%M:%S}",
    		"locale": "en_US.UTF-8"
	},
    	"custom/launcher": {
		"tooltip": false,
    		"format": "󰣇 ",
        	"on-click": "$HOME/.config/waybar/scripts/launcher.sh"
    	},
	"custom/nc": {
		"tooltip": false,
		"format": " ",
		"on-click": "swaync-client -t -sw"
	},
    	"custom/power": {
		"tooltip": false,
        	"format": " ",
        	"on-click": "$HOME/.config/waybar/scripts/power.sh",
    	},
    	"custom/updates":{
		"tooltip": false,
        	"format": "󰚰 {}",
        	"exec": "$HOME/.config/waybar/scripts/checkupdates.sh",
        	"exec-if": "[[ $($HOME/.config/waybar/scripts/checkupdates.sh) != 0 ]]",
        	"interval": 120,
        	"on-click": "kitty -e pkexec pacman -Syyu --noconfirm && if [ $? -ge 0 ]; then notify-send 'The system has been updated'; else notify-send 'The command failed to run'; fi"
    	},
	"custom/fanspeed":{
		"tooltip": false,
		"format": "󰈐 {}",
		"on-click": "$HOME/.config/waybar/scripts/fanspeed_toggle.sh",
		"exec": "$HOME/.config/waybar/scripts/fanspeed.sh",
		"interval": 5
	}
}
